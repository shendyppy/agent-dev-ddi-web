# Copy this file to .env and fill in real values.
# Never commit .env.

# ─── LLM (via LiteLLM gateway — see docs/guides/llm-gateway-and-model-swap.md) ───
# All LLM traffic in this repo routes through apps/backend/src/agent/llm.py,
# which uses LiteLLM. Switching providers is a single env var change here —
# NO code changes anywhere else. That's the whole point of the gateway.
#
# Format: LITELLM_MODEL=<provider>/<model> (provider prefix omitted for
# Anthropic since LiteLLM resolves bare Claude names automatically).
#
# Examples:
#   claude-sonnet-4-6                  (Anthropic — default; needs ANTHROPIC_API_KEY)
#   claude-haiku-4-5                   (Anthropic — cheaper/faster)
#   gemini/gemini-2.5-flash            (Google — needs GEMINI_API_KEY)
#   gemini/gemini-2.5-pro              (Google — slower, smarter)
#   gpt-4o                             (OpenAI — needs OPENAI_API_KEY)
#   gpt-4o-mini                        (OpenAI — cheap)
#   ollama/llama3.1                    (local via Ollama — no key)
LITELLM_MODEL=gemini/gemini-2.5-flash

# Provider API keys — set ONLY the one(s) matching the LITELLM_MODEL above.
# Unset keys are fine; LiteLLM only reads the key for the active provider.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# VOYAGE_API_KEY=          # only if switching embeddings to Voyage (see ADR 0004)

# ─── Vector store ───
# Persistent dir for ChromaDB. `just reindex` wipes this and rebuilds.
CHROMA_PERSIST_DIR=./.data/chroma

# ─── Observability (Langfuse self-hosted) ───
# Every LLM call through llm.py auto-traces here. Empty keys = traces are
# silently dropped (LiteLLM still works); set them once Langfuse is up.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Service ports ───
FRONTEND_PORT=4321
BACKEND_PORT=8000

# ─── MCP servers ───
# stdio by default; flip to "sse" for remote MCP servers
MCP_TRANSPORT=stdio
