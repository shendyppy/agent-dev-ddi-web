# Copy to .env. Never commit .env.
#
# Everything here is OPTIONAL — with no .env at all the app still runs: answers
# are quoted from the local docs index ("offline mode") and sign-in is hidden.
# Every other knob (ports, Langfuse, ChromaDB path, screenshots, fake mode…)
# has a working default: see apps/backend/src/agent/settings.py.

# 1) Model — set a key to get real LLM answers instead of offline mode.
#    Either the generic MODEL_API_KEY, or provider-specific keys (GEMINI_API_KEY,
#    ANTHROPIC_API_KEY, DEEPSEEK_API_KEY, OPENROUTER_API_KEY — set several to
#    enable them in the UI model picker).
MODEL_API_KEY=
LITELLM_MODEL=gemini/gemini-3.6-flash

# 2) Supabase — enables Google sign-in + chat history. Anon key ONLY — PUBLIC_
#    values are shipped to the browser, so NEVER put a service-role key here.
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# 3) Knowledge-base write access — optional, comma-separated. An entry may be
#    a full email (`someone@company.com`) or a domain suffix (`@company.com`).
#    Writers may SUBMIT documents (they land in docs/knowledge-base/_inbox/ and
#    are not searchable yet); maintainers may PUBLISH them into the corpus.
#    Leave KB_WRITER_EMAILS empty to allow any signed-in user — submission
#    always requires a verified Supabase session either way. An empty
#    KB_MAINTAINER_EMAILS falls back to the writer list.
KB_WRITER_EMAILS=
KB_MAINTAINER_EMAILS=

# 4) Ports — optional. BACKEND_PORT is the port `just dev` PREFERS; if
#    something else already holds it, dev steps to the next free one and tells
#    the frontend where it landed, so you do not have to keep these in sync by
#    hand. Run `just port-check` to see what it would pick right now.
BACKEND_PORT=8000

# 5) Deploy only — leave unset in local dev.
#    PUBLIC_API_BASE_URL is set automatically by `just dev`; setting it here
#    only matters for deployed builds (and a value here is overridden by the
#    one `just dev` exports).
CORS_ALLOWED_ORIGINS=
PUBLIC_API_BASE_URL=http://localhost:8000
