# Copy this file to .env and fill in real values.
# Never commit .env.

# ─── LLM (via LiteLLM gateway — see docs/guides/llm-gateway-and-model-swap.md) ───
# All LLM traffic in this repo routes through apps/backend/src/agent/llm.py,
# which uses LiteLLM. Switching providers is a single env var change here —
# NO code changes anywhere else. That's the whole point of the gateway.
#
# Format: LITELLM_MODEL=<provider>/<model> (provider prefix omitted for
# Anthropic since LiteLLM resolves bare Claude names automatically).
#
# Examples:
#   claude-sonnet-4-6                  (Anthropic — default; needs ANTHROPIC_API_KEY)
#   claude-haiku-4-5                   (Anthropic — cheaper/faster)
#   gemini/gemini-3.6-flash            (Google — needs GEMINI_API_KEY)
#   gemini/gemini-3.5-flash-lite       (Google — cheapest; weaker at tool calls)
#   gpt-4o                             (OpenAI — needs OPENAI_API_KEY)
#   gpt-4o-mini                        (OpenAI — cheap)
#   ollama/llama3.1                    (local via Ollama — no key)
#
# WARNING (Gemini only): Google retires model ids for *new* users with no
# deprecation window — `gemini-2.5-flash` and `gemini-2.5-flash-lite` both
# started returning 404 "no longer available to new users" in Jul 2026. They
# still appear in ListModels, so the only reliable check is a real call:
#   curl -s -o /dev/null -w "%{http_code}\n" -X POST \
#     "https://generativelanguage.googleapis.com/v1beta/models/<id>:generateContent?key=$GEMINI_API_KEY" \
#     -H "Content-Type: application/json" -d '{"contents":[{"parts":[{"text":"hi"}]}]}'
LITELLM_MODEL=gemini/gemini-3.6-flash

# Provider API keys — set ONLY the one(s) matching the LITELLM_MODEL above.
# Unset keys are fine; LiteLLM only reads the key for the active provider.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# VOYAGE_API_KEY=          # only if switching embeddings to Voyage (see ADR 0004)

# ─── Offline UI mode (dev only) ───
# true  = no provider request is ever made; answers are produced locally.
# false = normal operation.
#
# Use it for frontend work. The Gemini free tier allows 20 requests per DAY per
# model, which a few reloads exhaust — after that the chat returns 429 until it
# resets at midnight Pacific, and you cannot see how an answer renders.
#
# Never enable it for evals: every case would pass without a model.
LLM_FAKE_MODE=false

# Where a fake answer comes from:
#   true  (default) — run the REAL search_documentation tool against the local
#                     ChromaDB index and build the answer from the chunks it
#                     returns. Real text, real Sources paths, and it exercises
#                     the tool-chip / message-grouping UI too. Retrieval is
#                     local, so this still costs nothing.
#   false           — serve apps/backend/src/agent/fixtures/fake_answer.md,
#                     a static document that covers every markdown element on
#                     purpose (headings, nested lists, table, code fences,
#                     blockquote, long URL, Sources block). Better when the
#                     thing under test is markdown rendering itself.
# Falls back to the fixture automatically if the index is missing or empty.
# LLM_FAKE_USE_RETRIEVAL=true
# LLM_FAKE_LATENCY_SECONDS=0.6   # pause before replying, so the typing UI shows

# ─── Vector store ───
# Persistent dir for ChromaDB. `just reindex` wipes this and rebuilds.
CHROMA_PERSIST_DIR=./.data/chroma

# ─── Observability (Langfuse self-hosted) ───
# Every LLM call through llm.py auto-traces here. Empty keys = traces are
# silently dropped (LiteLLM still works); set them once Langfuse is up.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Service ports ───
FRONTEND_PORT=4321
BACKEND_PORT=8000

# ─── MCP servers ───
# stdio by default; flip to "sse" for remote MCP servers
MCP_TRANSPORT=stdio

# ─── Screenshot capture (capture_screenshot skill) ───
# Playwright PNGs land in <repo>/.data/screenshots and are served at
# /screenshots; the agent embeds that URL as a markdown image (ADR 0008).
# Defaults work locally with no config, so these are intentionally NOT set
# here: the value must reach the MCP subprocess, which inherits the OS
# environment — NOT this .env file (pydantic-settings does not export to
# os.environ). If you need to override SCREENSHOT_DIR or SCREENSHOT_BASE_URL,
# set them as real OS env vars so both the backend mount and the handler agree.
# SCREENSHOT_DIR=...
# SCREENSHOT_BASE_URL=http://localhost:8000

# ─── External source corpus ───
# Absolute path to the tep-web repo (Acelents website) whose source we index as
# the "acelents" product. Read by agent.indexing in the orchestrator process
# (which loads this .env), so a .env value works here. Host-specific — override
# per machine/CI.
TEP_WEB_ROOT=C:/Project/DDI/Acelents/tep-web
