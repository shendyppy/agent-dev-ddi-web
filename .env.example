# Copy to .env. Never commit .env.
#
# Everything here is OPTIONAL — with no .env at all the app still runs: answers
# are quoted from the local docs index ("offline mode") and sign-in is hidden.
# Every other knob (ports, Langfuse, ChromaDB path, screenshots, fake mode…)
# has a working default: see apps/backend/src/agent/settings.py.

# 1) Model — set a key to get real LLM answers instead of offline mode.
#    Either the generic MODEL_API_KEY, or provider-specific keys (GEMINI_API_KEY,
#    ANTHROPIC_API_KEY, DEEPSEEK_API_KEY, OPENROUTER_API_KEY — set several to
#    enable them in the UI model picker).
MODEL_API_KEY=
LITELLM_MODEL=gemini/gemini-3.6-flash

# 2) Supabase — enables Google sign-in + chat history. Anon key ONLY — PUBLIC_
#    values are shipped to the browser, so NEVER put a service-role key here.
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# 3) Deploy only — leave unset in local dev.
CORS_ALLOWED_ORIGINS=
PUBLIC_API_BASE_URL=http://localhost:8000
