# Copy this file to .env and fill in real values.
# Never commit .env.

# ---- LLM (LiteLLM) ----
# Default model. Switch providers without code changes.
# Examples:
#   claude-sonnet-4-6                 (Anthropic — recommended)
#   gpt-4o-mini                       (OpenAI)
#   ollama/llama3.1                   (local via Ollama)
LITELLM_MODEL=claude-sonnet-4-6

# Provider API keys (only set the one you're using)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# VOYAGE_API_KEY=          # only if switching embeddings to Voyage

# ---- Vector store ----
CHROMA_PERSIST_DIR=./.data/chroma

# ---- Observability (Langfuse self-hosted) ----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Service ports ----
FRONTEND_PORT=4321
BACKEND_PORT=8000

# ---- MCP servers ----
# stdio by default; flip to "sse" for remote MCP servers
MCP_TRANSPORT=stdio
