# Secrets
.env
.env.local
.env.*.local
# Catches .env.bak, .env.old, .env.save — the names an editor or a shell
# one-liner produces. The three patterns above do NOT match them, so a backup
# of a secrets file was committable by accident.
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.uv-cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node / pnpm
node_modules/
.pnpm-store/
*.log
npm-debug.log*
pnpm-debug.log*

