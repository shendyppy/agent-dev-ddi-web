---
// global.css is the Tailwind v4 entry point — it contains the @theme tokens,
// dark-mode overrides, and CSS islands (markdown-body, typing-dot keyframes).
// It must be imported here (the layout) so it is included in every page's
// generated bundle and the pre-hydration skeleton can read the CSS variables.
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Documentation Agent</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
